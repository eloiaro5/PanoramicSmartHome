<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Shelly.AddSwitchPage"
             Title="Switch"
             BackgroundColor="#111814">

    <ScrollView>
    <Grid Padding="20">
        <Border
            BackgroundColor="#f9faf7"
            Stroke="#26342c"
            StrokeThickness="1"
            VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <VerticalStackLayout Padding="20" Spacing="14">
                <Label
                    x:Name="TitleLabel"
                    Text="Add switch"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#111814" />

                <Label
                    Text="Name"
                    TextColor="#26342c" />
                <Entry
                    x:Name="NameEntry"
                    Placeholder="Living room light"
                    TextColor="#111814"
                    PlaceholderColor="#607066"
                    ReturnType="Next"
                    Completed="OnNameCompleted"
                    Unfocused="OnNameUnfocused" />

                <Label
                    Text="IP address"
                    TextColor="#26342c" />
                <Entry
                    x:Name="IpAddressEntry"
                    Placeholder="192.168.1.20"
                    TextColor="#111814"
                    PlaceholderColor="#607066"
                    Keyboard="Url"
                    ReturnType="Done" />

                <Label
                    Text="Groups"
                    TextColor="#26342c" />
                <FlexLayout x:Name="GroupBubbles" Wrap="Wrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry
                        x:Name="GroupsEntry"
                        Placeholder="Enter group names"
                        TextColor="#111814"
                        PlaceholderColor="#607066"
                        ReturnType="Done"
                        TextChanged="OnGroupsTextChanged"
                        Completed="OnGroupsCompleted" />
                    <Button
                        Grid.Column="1"
                        Text="Add"
                        BackgroundColor="#5F8A6A"
                        TextColor="#ffffff"
                        Clicked="OnAddGroupsClicked" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Yaw"
                            TextColor="#26342c" />
                        <Entry
                            x:Name="YawEntry"
                            Text="0"
                            TextColor="#111814"
                            PlaceholderColor="#607066"
                            Keyboard="Numeric"
                            ReturnType="Next" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label
                            Text="Pitch"
                            TextColor="#26342c" />
                        <Entry
                            x:Name="PitchEntry"
                            Text="0"
                            TextColor="#111814"
                            PlaceholderColor="#607066"
                            Keyboard="Numeric"
                            ReturnType="Done" />
                    </VerticalStackLayout>
                </Grid>

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12"
                    Margin="0,10,0,0">
                    <Button
                        Text="Cancel"
                        BackgroundColor="#A65A5A"
                        TextColor="#111814"
                        Clicked="OnCancelClicked" />
                    <Button
                        Grid.Column="1"
                        Text="Save"
                        BackgroundColor="#5F8A6A"
                        TextColor="#ffffff"
                        Clicked="OnSaveClicked" />
                </Grid>

                <Button
                    x:Name="DeleteButton"
                    Text="Delete"
                    BackgroundColor="#7A3434"
                    TextColor="#ffffff"
                    IsVisible="False"
                    Clicked="OnDeleteClicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
    </ScrollView>

</ContentPage>
